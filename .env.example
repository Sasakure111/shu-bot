# 复制本文件为 .env.prod 后填写。请勿把 .env.prod 提交到仓库。

# ===== NoneBot / OneBot 连接 =====
DRIVER=~fastapi+~websockets
# OneBot V11 实现（NapCat / Lagrange 等）的反向 WebSocket 地址
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# ===== 运行配置 =====
LOCALSTORE_USE_CWD=true
APSCHEDULER_AUTOSTART=true

# ===== DeepSeek（聊天 / 塔罗 / 宠物互动所需）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 水鱼查分器（maimai /b50 功能，可留空）=====
DIVING_FISH_TOKEN=

# ===== MCP 桥接 token（个人遥控用，可留空）=====
MCP_BRIDGE_TOKEN=
